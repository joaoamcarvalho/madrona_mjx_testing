<mujoco model="object">
  <option timestep="0.01">
    <flag eulerdamp="disable"/>
  </option>

  <visual>
    <headlight ambient=".4 .4 .4" diffuse=".8 .8 .8" specular="0.1 0.1 0.1"/>
    <map znear=".01"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <material name="self" rgba=".7 .5 .3 1"/>
    <material name="red" rgba="1. 0. 0. 1"/>

    <mesh name="obj" file="./b88bcf33f25c6cb15b4f129f868dedb.obj" scale="0.25 0.25 0.25"/>
    <material name="obj_material" rgba="0.7 0.5 0.3 1" specular="0.5" shininess="0.5" reflectance=".2"/>
  </asset>

  <default>
    <default class="pole">
      <joint type="hinge" axis="0 1 0" damping="2e-6"/>
      <geom type="capsule" fromto="0 0 0 0 0 1" size="0.045" material="self" mass=".1"/>
    </default>
  </default>

  <worldbody>
    <light name="light" pos="0 0 6"/>
    <camera name="fixed" pos="0 -4 1" zaxis="0 -1 0"/>
    <camera name="lookatobject" mode="targetbody" target="object" pos="0 -0.5 0.5"/>
    
    <body name="cart" pos="0 0 10">
      <joint name="slider" type="slide" limited="true" axis="1 0 0" range="-1.8 1.8" solreflimit=".08 1" damping="5e-4"/>
      <geom name="cart" type="box" size="0.2 0.15 0.1" material="self" mass="1"/>
      <body name="pole_1" childclass="pole">
        <joint name="hinge_1"/>
        <geom name="pole_1"/>
      </body>
    </body>

    <body name="object" pos="0 0 0.0" euler="10 20 -45">
      <freejoint/>
      <geom type="mesh" mesh="obj" material="red"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="slide" joint="slider" gear="10" ctrllimited="true" ctrlrange="-1 1" />
  </actuator>
</mujoco>